kimi.apiKey1=
kimi.apiKey2=
gemini.apiKey=
gemini.apiKey1=
gemini.apiKey2=
gpt4.apiKey1=
gpt4.apiKey2=
doubao.appKey=
doubao.appKey2=
qwen.key2=
qwen.key1=
vision_doubao.appKey=
vision_agicto.apiKey2=
vision_agicto.apiKey1=
bytedance_asr.appid=
bytedance_asr.token=
deepgram.token=
app.appId=
app.token=
auth.accessKey=
maomi.signKey=
maomi.uriPrefix=
maomi.aesKeyB64=
maomi.aesIvB64=
livekit.apiKey=
livekit.apiSecretA=
livekit.apiSecretB=
