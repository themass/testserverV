# 服务器密钥配置模板
#
# 部署时：cp secrets.properties.example secrets.properties，然后在服务器上填写真实值。
# secrets.properties 已在 .gitignore 中，不会被提交。
#
# 启动时指定路径：  java -Dsecrets.file=/home/web/config/secrets.properties -jar ...
# 不指定则读取工作目录下的 secrets.properties。
#
# 每个值是字面量的完整内容，包括前缀（例如 Bearer、Token 前缀要一起填）。
# 留空的密钥对应功能会在真正请求时失败，不影响服务启动。
#
devcto.apiKey2=
devcto.apiKey1=
devcto_deepseek.apiKey2=
devcto_deepseek.apiKey1=
deepseek.apiKey1=
deepseek.apiKey2=
kimi.apiKey=
kimi.apiKey1=
kimi.apiKey2=
gemini.apiKey=
gemini.apiKey1=
gemini.apiKey2=
gpt4.apiKey1=
gpt4.apiKey2=
doubao.appKey=
doubao.appKey2=
qwen.key2=
qwen.key1=
vision_doubao.appKey=
vision_agicto.apiKey2=
vision_agicto.apiKey1=
bytedance_asr.appid=
bytedance_asr.token=
deepgram.token=
app.appId=
app.token=
auth.accessKey=
maomi.signKey=
maomi.uriPrefix=
maomi.aesKeyB64=
maomi.aesIvB64=
livekit.apiKey=
livekit.apiSecretA=
livekit.apiSecretB=
# LiveKit 服务地址（必填，如 wss://<项目>.livekit.cloud）。未配置时 token 接口直接报错。
livekit.url=
bytedance_tts.appid=
bytedance_tts.token=

# 拍照解题（PhotoSolveController）
# API Key：火山方舟控制台 -> API Key。不要填到这里提交；部署时写进服务器上的 secrets.properties。
photosolve.doubao.apiKey=
# 接入点 id（形如 ep-2024xxxx-xxxxx）或模型名。必须是支持图片输入的视觉模型/接入点。
photosolve.doubao.model=
# 默认 https://ark.cn-beijing.volces.com/api/v3/，一般不用改
photosolve.doubao.endpoint=
# 一次请求最多几张图（默认 4）
photosolve.maxImages=
# 单张图上限，字节（默认 5242880 = 5MB）
photosolve.maxBytes=
# 调模型的总超时，秒（默认 60）
photosolve.timeoutSeconds=
# —— 拍照解题用量控制（都有默认值，留空即用默认；改了重启生效）——
# 免费用户每天可用次数（默认 10）
photosolve.quota.freePerDay=
# VIP（level>=1）每天可用次数（默认 50）
photosolve.quota.vipPerDay=
# 每用户每分钟最多几次，挡脚本（默认 3）
photosolve.quota.perMinute=
# 全站每天调用模型的总次数上限，超过返回 42902（默认 2000）。按豆包单价换算成你能接受的日账单
photosolve.quota.totalPerDay=
# 同一 clientRequestId 的成功结果缓存秒数，重试时直接回放、不重复扣费（默认 600；0 关闭）
photosolve.quota.idempotentSeconds=
