<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timeline.vpn.dao.db.BugReportDao">
	<insert id="insert" useGeneratedKeys="true" keyProperty="id">
		insert into vpn.bug_report(userId,devId,userIp,version,label,fileName,fileBytes,content,truncated,createdAt)
		values
			(#{userId},#{devId},#{userIp},#{version},#{label},#{fileName},#{fileBytes},#{content},#{truncated},#{createdAt})
	</insert>
</mapper>
