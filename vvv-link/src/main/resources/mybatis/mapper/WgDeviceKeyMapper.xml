<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.timeline.vpn.dao.db.WgDeviceKeyDao">

	<resultMap id="WgDeviceKeyMap" type="com.timeline.vpn.model.po.WgDeviceKeyPo">
		<id column="id" property="id"/>
		<result column="devId" property="devId"/>
		<result column="publicKey" property="publicKey"/>
	</resultMap>

	<!--
		幂等注册：同一 devId 重复提交覆盖旧公钥。
		客户端重装 App 或手动重置身份后会重新生成密钥对，此时必须能覆盖，
		否则这些用户会永久卡在"公钥对不上、握手失败"的状态。
	-->
	<insert id="upsert">
		insert into vpn.wg_device_key(devId, publicKey)
		values (#{devId}, #{publicKey})
		on duplicate key update publicKey = values(publicKey)
	</insert>

	<select id="getByDevId" resultMap="WgDeviceKeyMap">
		select id, devId, publicKey
		from vpn.wg_device_key
		where devId = #{devId}
	</select>

	<delete id="deleteByDevId">
		delete from vpn.wg_device_key where devId = #{devId}
	</delete>

</mapper>
